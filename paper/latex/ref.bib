@article{TAM2026114234,
  title    = {Evolving routing and sequencing policies for dynamic vehicle routing problem with time windows},
  journal  = {Applied Soft Computing},
  volume   = {189},
  pages    = {114234},
  year     = {2026},
  issn     = {1568-4946},
  doi      = {https://doi.org/10.1016/j.asoc.2025.114234},
  url      = {https://www.sciencedirect.com/science/article/pii/S1568494625015479},
  author   = {Nguyen Thi Tam and Ngo Duy Anh and Dao Van Tung and Binh {Huynh Thi Thanh} and Le Trong Vinh},
  keywords = {Genetic programming, Dynamic vehicle routing problem with time window},
  abstract = {The Dynamic Vehicle Routing Problem with Time Windows (DVRPTW) is a complex extension of the Vehicle Routing Problem. It involves optimizing the routing and scheduling of vehicles to service customer demands that arrive dynamically over time rather than being known in advance. Each customer has a specific time window during which they must be serviced, adding a layer of complexity. The challenge is to assign routes and sequences for the fleet of vehicles while considering constraints such as vehicle capacity, service time, and dynamically changing requests. In this paper, we consider DVRPTW with two objectives: minimizing the total cost and maximizing the number of accepted requests. We propose the genetic programming algorithm to solve DVRPTW. Genetic programming hyper-heuristic algorithm (GPHH) involves routing and sequencing policies over successive generations, automatically discovering rules and heuristics that can efficiently handle the dynamic nature of DVRPTW. Our proposed algorithm adaptively develops these solutions, making them particularly well-suited for problems where real-time changes in demand occur. The experiments conducted on many instances proved the effectiveness of our proposed algorithm compared with the existing heuristic algorithms.}
}


